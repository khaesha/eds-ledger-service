# Backend Environment Variables Template
# Copy this to .env and fill in actual values

# === DATABASE ===
# Supabase PostgreSQL connection string
# Format: postgresql://postgres:[PASSWORD]@[PROJECT-REF].supabase.co:5432/postgres?schema=public
# Replace [PASSWORD] and [PROJECT-REF] with your Supabase credentials
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD_HERE@your-project-ref.supabase.co:5432/postgres?schema=public"

# === JWT AUTH ===
# Secret key for signing JWT tokens (use a strong random string in production)
# Generate: openssl rand -base64 32
JWT_SECRET="your-secret-key-here-change-in-production"

# === AI SERVICE ===
# OpenRouter API key for LLM (Llama 3.1 8B via OpenRouter)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-your-key-here"

# === SERVER CONFIG ===
# Port the backend runs on
PORT=3001

# Frontend URL for CORS
FRONTEND_URL="http://localhost:3000"

# Environment: development, staging, production
NODE_ENV="development"
